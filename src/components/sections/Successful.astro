---
import Container from "../shared/Container.astro";
---

<section id="success" class="relative pt-32">
  <Container className="py-8">
    <div class="flex flex-col w-full px-6 text-heading-1 items-center gap-10">
      <div class="w-fit">
        <img
          src="/images/check.webp"
          alt="check"
          class="object-contain max-w-20"
          width="100"
        />
      </div>
      <div class="text-base md:text-xl text-center">
        Gracias por Contactarnos
        <br />
        Te daremos respuesta lo más breve posible
      </div>
      <button class="rounded-full bg-yellow-500 p-3"
        ><a href="/" class="">Volver al Inicio</a></button
      >
    </div>
  </Container>
</section>
